<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="WinTune VI — Cài đặt Windows" Width="1280" Height="860" MinWidth="900" MinHeight="560" WindowStartupLocation="CenterScreen" Background="{DynamicResource Theme.WindowBrush}" Foreground="{DynamicResource Theme.TextBrush}" FontFamily="Segoe UI" FontSize="14">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource Theme.ButtonBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource Theme.TextBrush}" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="ContentTemplate">
        <Setter.Value>
          <DataTemplate>
            <TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center" />
          </DataTemplate>
        </Setter.Value>
      </Setter>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Surface" Property="Opacity" Value="0.8" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Surface" Property="Opacity" Value="0.45" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Theme.AccentBrush}" />
                <Setter TargetName="Surface" Property="BorderThickness" Value="1" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource Theme.TextBrush}" />
    </Style>
    <Style TargetType="ListViewItem">
      <Setter Property="Foreground" Value="{DynamicResource Theme.TextBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="6,4" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListViewItem">
            <Border x:Name="ProcessRowSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
              <GridViewRowPresenter Content="{TemplateBinding Content}" Columns="{Binding View.Columns, RelativeSource={RelativeSource AncestorType={x:Type ListView}}}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ProcessRowSurface" Property="Background" Value="{DynamicResource Theme.HoverBrush}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="ProcessRowSurface" Property="Background" Value="{DynamicResource Theme.SelectedBrush}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="ProcessRowSurface" Property="BorderBrush" Value="{DynamicResource Theme.AccentBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ToolTip">
      <Setter Property="Background" Value="{DynamicResource Theme.SurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource Theme.TextBrush}" />
    </Style>
    <Style TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Theme.AccentBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,20,0,7" />
    </Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="10,12" />
      <Setter Property="Foreground" Value="{DynamicResource Theme.TextBrush}" />
      <Setter Property="Margin" Value="0,0,0,4" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="6">
              <ContentPresenter HorizontalAlignment="Stretch" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="{DynamicResource Theme.SelectedBrush}" />
        </Trigger>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{DynamicResource Theme.HoverBrush}" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Theme.SurfaceBrush}" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="18" />
      <Setter Property="Margin" Value="5,0,5,10" />
    </Style>
    <Style x:Key="RowCard" TargetType="Border" BasedOn="{StaticResource Card}">
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource Theme.TextBrush}" />
      <Setter Property="Background" Value="{DynamicResource Theme.ButtonBrush}" />
      <Setter Property="Padding" Value="10,8" />
      <Style.Triggers>
        <Trigger Property="IsHighlighted" Value="True">
          <Setter Property="Background" Value="{DynamicResource Theme.SelectedBrush}" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="{DynamicResource Theme.TextBrush}" />
      <Setter Property="Background" Value="{DynamicResource Theme.SurfaceBrush}" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton Foreground="{TemplateBinding Foreground}" Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border Background="{DynamicResource Theme.SurfaceBrush}" BorderBrush="{DynamicResource Theme.BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,7">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition />
                          <ColumnDefinition Width="18" />
                        </Grid.ColumnDefinitions>
                        <ContentPresenter />
                        <TextBlock Grid.Column="1" Text="⌄" Foreground="{DynamicResource Theme.MutedBrush}" HorizontalAlignment="Right" />
                      </Grid>
                    </Border>
                  </ControlTemplate>
                </ToggleButton.Template>
                <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" HorizontalAlignment="Left" />
              </ToggleButton>
              <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True">
                <Border Background="{DynamicResource Theme.ButtonBrush}" CornerRadius="6" Padding="3" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                  <ScrollViewer MaxHeight="280">
                    <ItemsPresenter />
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="GridViewColumnHeader">
      <Setter Property="Background" Value="{DynamicResource Theme.InputBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource Theme.MutedBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
    <ControlTemplate x:Key="Theme.ScrollPage" TargetType="RepeatButton">
      <Border Background="Transparent" />
    </ControlTemplate>
    <Style x:Key="Theme.ScrollThumb" TargetType="Thumb">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border Background="{DynamicResource Theme.BorderBrush}" CornerRadius="5" Margin="2" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <ControlTemplate x:Key="Theme.VerticalScroll" TargetType="ScrollBar">
      <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
        <Track.DecreaseRepeatButton>
          <RepeatButton Command="ScrollBar.PageUpCommand" Template="{StaticResource Theme.ScrollPage}" Focusable="False" />
        </Track.DecreaseRepeatButton>
        <Track.Thumb>
          <Thumb Style="{StaticResource Theme.ScrollThumb}" />
        </Track.Thumb>
        <Track.IncreaseRepeatButton>
          <RepeatButton Command="ScrollBar.PageDownCommand" Template="{StaticResource Theme.ScrollPage}" Focusable="False" />
        </Track.IncreaseRepeatButton>
      </Track>
    </ControlTemplate>
    <ControlTemplate x:Key="Theme.HorizontalScroll" TargetType="ScrollBar">
      <Track x:Name="PART_Track" Orientation="Horizontal" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
        <Track.DecreaseRepeatButton>
          <RepeatButton Command="ScrollBar.PageLeftCommand" Template="{StaticResource Theme.ScrollPage}" Focusable="False" />
        </Track.DecreaseRepeatButton>
        <Track.Thumb>
          <Thumb Style="{StaticResource Theme.ScrollThumb}" />
        </Track.Thumb>
        <Track.IncreaseRepeatButton>
          <RepeatButton Command="ScrollBar.PageRightCommand" Template="{StaticResource Theme.ScrollPage}" Focusable="False" />
        </Track.IncreaseRepeatButton>
      </Track>
    </ControlTemplate>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="12" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Template" Value="{StaticResource Theme.VerticalScroll}" />
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Width" Value="Auto" />
          <Setter Property="Height" Value="12" />
          <Setter Property="Template" Value="{StaticResource Theme.HorizontalScroll}" />
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>
  <Grid Margin="16" Background="{DynamicResource Theme.WindowBrush}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="218" />
      <ColumnDefinition Width="20" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="{DynamicResource Theme.WindowBrush}" CornerRadius="10" Padding="8,12">
      <DockPanel>
        <Border DockPanel.Dock="Bottom" Padding="8,14,8,0">
          <StackPanel>
            <TextBlock Text="Giao diện" FontSize="13" Foreground="{DynamicResource Theme.MutedBrush}" Margin="0,0,0,6" />
            <ComboBox x:Name="ThemeChoice" ToolTip="Chỉ đổi giao diện WinTune. Theo hệ thống dùng màu dành cho ứng dụng của Windows." AutomationProperties.Name="Chọn giao diện" />
            <TextBlock x:Name="ThemeStatus" FontSize="11" Foreground="{DynamicResource Theme.WarningBrush}" Margin="0,6,0,0" Visibility="Collapsed" />
          </StackPanel>
        </Border>
        <StackPanel DockPanel.Dock="Top" Margin="10,0,6,12">
          <TextBlock Text="WinTune VI" FontSize="24" FontWeight="SemiBold" />
          <TextBlock x:Name="AppVersion" Text="0.15.0 • Portable" Foreground="{DynamicResource Theme.SubtleBrush}" FontSize="11" Margin="0,8,0,0" />
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <Button x:Name="Overview" Content="⌂   Tổng quan máy tính" Margin="0,0,0,4" Padding="8,6" />
            <Button x:Name="FeaturesNav" Content="⚙   Tùy chỉnh Windows" Margin="0,0,0,4" Padding="8,6" />
            <TextBlock Text="ỨNG DỤNG &amp; CÔNG CỤ" Foreground="{DynamicResource Theme.MutedBrush}" FontSize="11" Margin="10,8,0,5" />
            <Button x:Name="ManageApps" Content="Gỡ ứng dụng" Margin="0,0,0,4" Padding="8,6" />
            <Button x:Name="ManageStartup" Content="Ứng dụng khởi động" Margin="0,0,0,4" Padding="8,6" />
            <Button x:Name="Software" Content="Cài ứng dụng" Margin="0,0,0,4" Padding="8,6" />
            <Button x:Name="Cleanup" Content="Dung lượng ổ đĩa" Margin="0,0,0,4" Padding="8,6" />
            <Button x:Name="Repair" Content="Sửa lỗi Windows" Margin="0,0,0,4" Padding="8,6" />
            <Grid Margin="0,12,0,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <Button x:Name="Undo" Content="Hoàn tác" ToolTip="Hoàn tác đợt tùy chỉnh gần nhất" Padding="8,8" Margin="0,0,4,0" />
              <Button x:Name="History" Grid.Column="1" Content="Lịch sử" ToolTip="Xem kết quả và lịch sử thay đổi" Padding="8,8" Margin="4,0,0,0" />
            </Grid>
            <StackPanel Margin="0">
              <TextBlock Text="KHÔI PHỤC WINDOWS" FontSize="11" Foreground="{DynamicResource Theme.MutedBrush}" Margin="10,8,0,5" />
              <Button x:Name="BackupTools" Content="Tạo mốc khôi phục" Margin="0,0,0,4" Padding="8,6" />
              <Button x:Name="RestoreWindows" Content="Quay về mốc cũ" Margin="0,0,0,4" Padding="8,6" />
            </StackPanel>
            <StackPanel Margin="0">
              <TextBlock Text="CÔNG CỤ WINDOWS" FontSize="11" Foreground="{DynamicResource Theme.MutedBrush}" Margin="10,8,0,5" />
              <Button x:Name="DeviceManager" Content="Quản lý thiết bị" Margin="0,0,0,4" Padding="8,6" />
              <Button x:Name="EventViewer" Content="Lỗi Windows và ứng dụng" Margin="0,0,0,4" Padding="8,6" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>
    <Grid Grid.Column="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel Margin="0,4,0,22">
        <TextBlock x:Name="PageTitle" Text="Tùy chỉnh Windows" FontSize="30" FontWeight="SemiBold" />
        <TextBlock x:Name="Machine" Foreground="{DynamicResource Theme.MutedBrush}" FontSize="12" Margin="0,8,0,0" />
      </StackPanel>
      <ScrollViewer x:Name="DashboardPage" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,10,8">
          <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Thông tin thiết bị" FontSize="20" FontWeight="SemiBold" />
              <TextBlock Text="Thông số từ Windows • Chỉ đọc, không thay đổi máy" Foreground="{DynamicResource Theme.MutedBrush}" FontSize="12" Margin="0,5,0,0" />
            </StackPanel>
            <Button x:Name="HardwareRefresh" Grid.Column="1" Content="Đọc lại cấu hình" Margin="8,0,0,0" VerticalAlignment="Center" />
          </Grid>
          <UniformGrid x:Name="HardwareCards" Columns="2" Margin="-5,0,-5,12">
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Bộ xử lý" Foreground="{DynamicResource Theme.MutedBrush}" />
                <TextBlock x:Name="CpuName" Text="Đang đọc bộ xử lý…" FontSize="18" FontWeight="SemiBold" Margin="0,14,0,18" />
                <TextBlock x:Name="CpuSpecs" Text="Nhân và luồng" Foreground="{DynamicResource Theme.MutedBrush}" FontSize="12" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="RAM đã lắp" Foreground="{DynamicResource Theme.MutedBrush}" />
                <TextBlock x:Name="RamSize" Text="Đang đọc…" FontSize="22" FontWeight="SemiBold" Margin="0,14,0,18" />
                <TextBlock x:Name="RamSpecs" Text="Tốc độ và dung lượng" Foreground="{DynamicResource Theme.MutedBrush}" FontSize="12" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Card đồ họa" Foreground="{DynamicResource Theme.MutedBrush}" />
                <TextBlock x:Name="GpuSize" Text="Đang đọc…" FontSize="22" FontWeight="SemiBold" Margin="0,14,0,18" />
                <TextBlock x:Name="GpuName" Text="Thông tin GPU" Foreground="{DynamicResource Theme.MutedBrush}" FontSize="12" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Lưu trữ" Foreground="{DynamicResource Theme.MutedBrush}" />
                <TextBlock x:Name="StorageSize" Text="Đang đọc…" FontSize="22" FontWeight="SemiBold" Margin="0,14,0,18" />
                <TextBlock x:Name="StorageSpecs" Text="Các ổ cục bộ" Foreground="{DynamicResource Theme.MutedBrush}" FontSize="12" />
              </StackPanel>
            </Border>
          </UniformGrid>
          <Grid Margin="0,4,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Hoạt động hiện tại" FontSize="20" FontWeight="SemiBold" />
              <TextBlock x:Name="MonitorStatus" Text="Đang chờ dữ liệu Windows…" Foreground="{DynamicResource Theme.MutedBrush}" FontSize="12" Margin="0,5,0,0" />
            </StackPanel>
            <Button x:Name="MonitorPause" Grid.Column="1" Content="Tạm dừng" Margin="8,0,0,0" VerticalAlignment="Center" />
          </Grid>
          <UniformGrid Columns="2" Margin="-5,0,-5,4">
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <DockPanel>
                  <TextBlock Text="CPU" />
                  <TextBlock x:Name="CpuUsage" Text="Đang lấy mẫu…" HorizontalAlignment="Right" FontSize="24" FontWeight="SemiBold" />
                </DockPanel>
                <Border Background="{DynamicResource Theme.ChartBrush}" CornerRadius="6" Margin="0,12,0,0">
                  <Canvas x:Name="CpuCanvas" Height="90" ClipToBounds="True">
                    <Polyline x:Name="CpuGraph" Stroke="{DynamicResource Theme.AccentBrush}" StrokeThickness="2" />
                  </Canvas>
                </Border>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <DockPanel>
                  <TextBlock Text="RAM" />
                  <TextBlock x:Name="RamUsage" Text="Đang lấy mẫu…" HorizontalAlignment="Right" FontSize="24" FontWeight="SemiBold" />
                </DockPanel>
                <Border Background="{DynamicResource Theme.ChartBrush}" CornerRadius="6" Margin="0,12,0,0">
                  <Canvas x:Name="RamCanvas" Height="90" ClipToBounds="True">
                    <Polyline x:Name="RamGraph" Stroke="{DynamicResource Theme.PurpleBrush}" StrokeThickness="2" />
                  </Canvas>
                </Border>
                <TextBlock x:Name="RamUsageDetail" Foreground="{DynamicResource Theme.MutedBrush}" FontSize="12" Margin="0,6,0,0" />
              </StackPanel>
            </Border>
          </UniformGrid>
          <TextBlock Text="Biểu đồ tối đa 60 mẫu • CPU và RAM từ 0 đến 100%" Foreground="{DynamicResource Theme.MutedBrush}" FontSize="12" Margin="0,0,0,12" />
          <Border Style="{StaticResource RowCard}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Tiến trình đang chạy" Foreground="{DynamicResource Theme.MutedBrush}" />
                <TextBlock x:Name="ProcessCount" Text="—" FontSize="24" FontWeight="SemiBold" />
              </StackPanel>
              <StackPanel Grid.Column="1">
                <TextBlock Text="GPU • Bộ máy bận nhất" Foreground="{DynamicResource Theme.MutedBrush}" />
                <TextBlock x:Name="GpuUsage" Text="Đang lấy mẫu…" FontSize="22" FontWeight="SemiBold" />
              </StackPanel>
            </Grid>
          </Border>
          <Border Style="{StaticResource RowCard}">
            <StackPanel>
              <TextBlock Text="Mạng • Tổng bộ đếm các card đang hoạt động" Foreground="{DynamicResource Theme.MutedBrush}" />
              <TextBlock x:Name="NetworkUsage" Text="Đang lấy mẫu…" FontSize="18" Margin="0,6,0,0" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource RowCard}">
            <StackPanel>
              <TextBlock Text="Ổ đĩa • Tốc độ đọc và ghi" Foreground="{DynamicResource Theme.MutedBrush}" />
              <TextBlock x:Name="DiskUsage" Text="Đang lấy mẫu…" FontSize="18" Margin="0,6,0,0" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource RowCard}">
            <StackPanel>
              <TextBlock Text="10 tiến trình dùng RAM nhiều nhất" FontSize="18" FontWeight="SemiBold" />
              <TextBlock x:Name="ProcessStatus" Text="Tự cập nhật mỗi 2 giây khi đang xem Tổng quan." Foreground="{DynamicResource Theme.MutedBrush}" FontSize="12" Margin="0,6,0,0" />
              <TextBlock Text="Working set gồm cả bộ nhớ chia sẻ; không cộng các hàng để tính tổng RAM." Foreground="{DynamicResource Theme.MutedBrush}" FontSize="12" Margin="0,6,0,12" />
              <ListView x:Name="ProcessList" Background="{DynamicResource Theme.SurfaceBrush}" Foreground="{DynamicResource Theme.TextBrush}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <ListView.View>
                  <GridView>
                    <GridViewColumn Header="Tiến trình" Width="230" DisplayMemberBinding="{Binding Name}" />
                    <GridViewColumn Header="PID" Width="70" DisplayMemberBinding="{Binding Id}" />
                    <GridViewColumn Header="RAM" Width="120" DisplayMemberBinding="{Binding Memory}" />
                  </GridView>
                </ListView.View>
              </ListView>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource RowCard}">
            <StackPanel>
              <TextBlock Text="Chi tiết phần cứng và Windows" FontSize="18" FontWeight="SemiBold" />
              <TextBlock x:Name="HardwareDetails" Text="Đang đọc cấu hình…" Margin="0,16,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Theme.MutedBrush}" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource RowCard}" Margin="0,8,0,8">
            <StackPanel>
              <TextBlock Text="Bảo mật và thiết bị" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="150" />
                  <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Button x:Name="DashboardDiagnostics" Content="Kiểm tra ngay" VerticalAlignment="Top" Margin="0,0,14,0" />
                <TextBlock Grid.Column="1" Text="Xem Windows Defender, tường lửa, TPM (chip bảo mật), Secure Boot (kiểm tra phần mềm khởi động) và thiết bị Windows đang báo lỗi. Chỉ kiểm tra, không sửa thiết lập." Foreground="{DynamicResource Theme.MutedBrush}" FontSize="13" />
              </Grid>
              <TextBlock x:Name="DiagnosticsStatus" Text="Chưa kiểm tra." Foreground="{DynamicResource Theme.MutedBrush}" FontSize="12" Margin="0,12,0,0" />
              <StackPanel x:Name="DiagnosticsResults" Visibility="Collapsed" Margin="0,14,0,0">
                <UniformGrid Columns="2">
                  <Border Background="{DynamicResource Theme.InputBrush}" Padding="12" Margin="0,0,6,8" CornerRadius="6">
                    <StackPanel>
                      <TextBlock Text="Windows Defender" FontWeight="SemiBold" />
                      <TextBlock x:Name="DiagnosticsDefender" Margin="0,8,0,0" />
                      <TextBlock Text="Nếu dùng phần mềm chống virus khác, hãy kiểm tra thêm trong phần mềm đó." Foreground="{DynamicResource Theme.MutedBrush}" FontSize="12" Margin="0,8,0,0" />
                    </StackPanel>
                  </Border>
                  <Border Background="{DynamicResource Theme.InputBrush}" Padding="12" Margin="6,0,0,8" CornerRadius="6">
                    <StackPanel>
                      <TextBlock Text="Tường lửa Windows" FontWeight="SemiBold" />
                      <TextBlock x:Name="DiagnosticsFirewall" Margin="0,8,0,0" />
                      <TextBlock Text="Windows dùng cấu hình tương ứng với mạng đang kết nối." Foreground="{DynamicResource Theme.MutedBrush}" FontSize="12" Margin="0,8,0,0" />
                    </StackPanel>
                  </Border>
                  <Border Background="{DynamicResource Theme.InputBrush}" Padding="12" Margin="0,0,6,8" CornerRadius="6">
                    <StackPanel>
                      <TextBlock Text="TPM — chip bảo mật" FontWeight="SemiBold" />
                      <TextBlock x:Name="DiagnosticsTpm" Margin="0,8,0,0" />
                    </StackPanel>
                  </Border>
                  <Border Background="{DynamicResource Theme.InputBrush}" Padding="12" Margin="6,0,0,8" CornerRadius="6">
                    <StackPanel>
                      <TextBlock Text="Secure Boot — bảo vệ khởi động" FontWeight="SemiBold" />
                      <TextBlock x:Name="DiagnosticsBoot" Margin="0,8,0,0" />
                    </StackPanel>
                  </Border>
                </UniformGrid>
                <TextBlock Text="Thiết bị Windows báo lỗi" FontWeight="SemiBold" Margin="0,8,0,6" />
                <TextBlock x:Name="DiagnosticsDevices" />
                <TextBlock Text="Mã lỗi có thể liên quan đến driver, phần cứng hoặc thiết bị chưa kết nối; không phải mọi lỗi đều do driver." Foreground="{DynamicResource Theme.MutedBrush}" FontSize="12" Margin="0,8,0,0" />
              </StackPanel>
            </StackPanel>
          </Border>
          <Expander Header="Thông tin bộ đếm chưa khả dụng" Foreground="{DynamicResource Theme.MutedBrush}" Margin="0,10,0,8">
            <TextBlock x:Name="MonitorIssues" Margin="0,10,0,0" FontSize="12" />
          </Expander>
        </StackPanel>
      </ScrollViewer>
      <Grid x:Name="FeaturesPage" Grid.Row="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="185" />
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,14,0">
            <TextBlock Text="Chọn nhanh" FontSize="13" Margin="0,0,0,6" />
            <ComboBox x:Name="Profile" MinHeight="40" AutomationProperties.Name="Chọn nhanh các thiết lập" ToolTip="Chọn một nhóm thiết lập để xem trước. Chưa áp dụng thay đổi." />
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="0,0,12,0">
            <TextBlock Text="Tìm tính năng" FontSize="13" Margin="0,0,0,6" />
            <Grid>
              <TextBox x:Name="Search" Background="{DynamicResource Theme.SurfaceBrush}" Foreground="{DynamicResource Theme.TextBrush}" BorderBrush="{DynamicResource Theme.BorderBrush}" Padding="10" MinHeight="40" ToolTip="Tìm tính năng, có hoặc không dấu" AutomationProperties.Name="Tìm tính năng" />
              <TextBlock Text="Nhập tên hoặc từ khóa…" Foreground="{DynamicResource Theme.MutedBrush}" Margin="11,0" VerticalAlignment="Center" IsHitTestVisible="False">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Text, ElementName=Search}" Value="">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </Grid>
          </StackPanel>
          <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
            <Button x:Name="FullFeatures" Content="Xem toàn bộ tùy chỉnh" ToolTip="Các mục trong ảnh WinUtil và Win11Debloat, có giải thích tiếng Việt" Background="{DynamicResource Theme.AccentButtonBrush}" Foreground="{DynamicResource Theme.OnAccentBrush}" Margin="0,0,0,6" MinHeight="38" />
            <Button x:Name="Refresh" Content="Đọc lại" ToolTip="Đọc lại trạng thái các thiết lập Windows" Margin="0" MinHeight="38" />
          </StackPanel>
          <CheckBox x:Name="OnlySelected" Grid.Row="1" Content="Chỉ hiện mục đã chọn" Margin="0,10,0,0" Grid.ColumnSpan="2" />
          <TextBlock x:Name="Count" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" HorizontalAlignment="Right" Foreground="{DynamicResource Theme.MutedBrush}" FontSize="12" Margin="0,10,0,0" />
        </Grid>
        <Border Grid.Row="1" Background="{DynamicResource Theme.SurfaceBrush}" CornerRadius="8" Padding="9" Margin="0,0,0,8">
          <StackPanel>
            <TextBlock x:Name="ApplyBlockReason" Visibility="Collapsed" Foreground="{DynamicResource Theme.WarningBrush}" FontSize="13" Margin="0,0,0,8" />
            <TextBlock x:Name="ChosenHeading" Text="Đang chọn: 0 tính năng" FontWeight="SemiBold" />
            <TextBlock x:Name="SelectionEmpty" Text="Chọn các mục muốn thay đổi, rồi nhấn Xem trước và áp dụng để kiểm tra." Foreground="{DynamicResource Theme.MutedBrush}" FontSize="12" Margin="0,3,0,0" />
            <ScrollViewer x:Name="SelectionChips" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="78" Margin="0,6,0,0">
              <WrapPanel x:Name="SelectedFeatures" />
            </ScrollViewer>
          </StackPanel>
        </Border>
        <ListBox x:Name="FeatureList" HorizontalContentAlignment="Stretch" Grid.Row="2" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="False">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.GroupStyle>
            <GroupStyle>
              <GroupStyle.ContainerStyle>
                <Style TargetType="GroupItem">
                  <Setter Property="Width" Value="{DynamicResource FeatureGroupWidth}" />
                  <Setter Property="Margin" Value="4,0,4,8" />
                  <Setter Property="VerticalAlignment" Value="Top" />
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="GroupItem">
                        <Border Background="{DynamicResource Theme.SurfaceBrush}" CornerRadius="8" Padding="8">
                          <StackPanel>
                            <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Theme.AccentBrush}" Margin="6,3,6,6" />
                            <ItemsPresenter />
                          </StackPanel>
                        </Border>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </GroupStyle.ContainerStyle>
              <GroupStyle.Panel>
                <ItemsPanelTemplate>
                  <WrapPanel HorizontalAlignment="Stretch" />
                </ItemsPanelTemplate>
              </GroupStyle.Panel>
            </GroupStyle>
          </ListBox.GroupStyle>
        </ListBox>
        <Border x:Name="DetailDrawer" Grid.RowSpan="3" Panel.ZIndex="5" Width="430" HorizontalAlignment="Right" Visibility="Collapsed" Background="{DynamicResource Theme.SurfaceBrush}" CornerRadius="8" Padding="20">
          <DockPanel>
            <Button x:Name="CloseDetail" DockPanel.Dock="Top" Content="Đóng chi tiết ×" HorizontalAlignment="Right" Margin="0,0,0,12" />
            <ScrollViewer x:Name="DetailScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel>
                <TextBlock x:Name="DetailGroup" Foreground="{DynamicResource Theme.AccentBrush}" FontSize="12" />
                <TextBlock x:Name="DetailTitle" FontSize="23" FontWeight="SemiBold" Margin="0,8,0,12" Text="Chọn một tính năng" />
                <TextBlock x:Name="DetailState" Foreground="{DynamicResource Theme.MutedBrush}" />
                <Button x:Name="Toggle" Content="Thêm vào danh sách áp dụng" Foreground="{DynamicResource Theme.OnAccentBrush}" Background="{DynamicResource Theme.AccentButtonBrush}" Margin="0,18,0,0" />
                <TextBlock Text="Tác dụng" Style="{StaticResource Label}" />
                <TextBlock x:Name="DetailBenefit" />
                <TextBlock Text="Ảnh hưởng cần biết" Style="{StaticResource Label}" />
                <TextBlock x:Name="DetailCost" Foreground="{DynamicResource Theme.WarningBrush}" />
                <TextBlock Text="Phù hợp khi nào" Style="{StaticResource Label}" />
                <TextBlock x:Name="DetailWho" />
                <Expander Header="Hiệu lực và hoàn tác" Foreground="{DynamicResource Theme.MutedBrush}" Margin="0,20,0,0">
                  <TextBlock x:Name="DetailUndo" Foreground="{DynamicResource Theme.MutedBrush}" Margin="0,10,0,0" />
                </Expander>
                <Expander Header="Chi tiết kỹ thuật và nguồn" Foreground="{DynamicResource Theme.MutedBrush}" Margin="0,20,0,0">
                  <StackPanel>
                    <TextBox x:Name="Technical" IsReadOnly="True" TextWrapping="Wrap" Background="{DynamicResource Theme.InputBrush}" Foreground="{DynamicResource Theme.MutedBrush}" BorderThickness="0" Padding="10" Margin="0,10,0,10" />
                    <TextBlock x:Name="Source" />
                  </StackPanel>
                </Expander>
              </StackPanel>
            </ScrollViewer>
          </DockPanel>
        </Border>
      </Grid>
      <Grid x:Name="FeatureFooter" Grid.Row="2" Margin="0,18,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="SelectionCount" Text="Chưa chọn tính năng nào" FontWeight="SemiBold" />
          <TextBlock x:Name="Status" Text="Chọn thiết lập rồi xem trước thay đổi." Foreground="{DynamicResource Theme.MutedBrush}" FontSize="12" />
        </StackPanel>
        <Button x:Name="Clear" Grid.Column="1" Content="Bỏ chọn" />
        <Button x:Name="Preview" ToolTipService.ShowOnDisabled="True" Grid.Column="2" Content="Xem trước và áp dụng" Foreground="{DynamicResource Theme.OnAccentBrush}" Background="{DynamicResource Theme.AccentButtonBrush}" Margin="0" />
      </Grid>
    </Grid>
  </Grid>
</Window>